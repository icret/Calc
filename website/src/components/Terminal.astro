---
import type { Locale } from '~/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const placeholder = locale === 'zh-Hans' ? '2^128, sin(pi/4), ...' : '2^128, sin(pi/4), ...';
---

<div
  class="w-full max-w-md rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/70 dark:bg-zinc-900/50 p-5 font-mono text-sm backdrop-blur-xl backdrop-saturate-150 shadow-glass"
>
  <div class="mb-4 flex items-center justify-between">
    <div class="flex items-center gap-1.5 text-xs text-zinc-400 dark:text-zinc-600">
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
      ~/auracalc
    </div>
    <div class="flex gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
    </div>
  </div>
  <div class="h-[200px] space-y-2 overflow-y-auto pr-1" data-terminal-output></div>
  <div class="mt-3 flex items-center gap-2 border-t border-zinc-200/60 dark:border-zinc-800/60 pt-3">
    <span class="text-accent">&gt;</span>
    <input
      type="text"
      class="flex-1 bg-transparent text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 dark:placeholder:text-zinc-600 focus:outline-none"
      placeholder={placeholder}
      data-terminal-input
      autocomplete="off"
    />
  </div>
</div>

<script>
  const examples: Array<[string, string]> = [
    ['128 × 7.2', '921.6'],
    ['π', '3.14159265358979'],
    ['sin(π/4)', '0.707106781186547'],
    ['2^10 + 256', '1280'],
    ['x = 5', '5'],
    ['x² + 1', '26'],
    ['e', '2.71828182845905'],
    ['log(100)', '2'],
    ['15.5 ÷ 3', '5.16666666666667'],
    ['√(3²+4²)', '5'],
    ['π × 5²', '78.5398163397448'],
  ];

  const evaluate = (expr: string): number | null => {
    const safe = expr
      .replaceAll('^', '**')
      .replace(/\bpi\b/gi, 'Math.PI')
      .replace(/\be\b/g, 'Math.E')
      .replace(/\b(sin|cos|tan|sqrt|log|abs|exp|pow|floor|ceil|round)\b/g, 'Math.$1');
    if (!/^[\d+\-*/().%|&<>\sMathPIEsincotaqrlgbxfp]+$/.test(safe)) return null;
    try {
      const result = Function(`"use strict"; return (${safe})`)();
      return typeof result === 'number' && Number.isFinite(result) ? result : null;
    } catch {
      return null;
    }
  };

  const termOutput = document.querySelector('[data-terminal-output]') as HTMLElement | null;
  const termInput = document.querySelector('[data-terminal-input]') as HTMLInputElement | null;

  if (termOutput && termInput) {
    const scrollToBottom = () => {
      termOutput.scrollTop = termOutput.scrollHeight;
    };

    const addLine = (expr: string, result: string) => {
      const line = document.createElement('div');
      const q = document.createElement('div');
      q.className = 'text-zinc-600 dark:text-zinc-300';
      q.textContent = `> ${expr}`;
      const a = document.createElement('div');
      a.className = 'text-accent';
      a.textContent = `= ${result}`;
      line.append(q, a);
      termOutput.appendChild(line);
      while (termOutput.children.length > 8) {
        termOutput.removeChild(termOutput.firstChild!);
      }
      scrollToBottom();
    };

    const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));

    let typewriterActive = true;
    let typewriterIndex = 0;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const typewriter = async () => {
      if (reduceMotion) {
        for (const [expr, result] of examples.slice(0, 5)) {
          addLine(expr, result);
        }
        return;
      }
      while (typewriterActive) {
        const [expr, result] = examples[typewriterIndex % examples.length];
        const line = document.createElement('div');
        const inputLine = document.createElement('div');
        inputLine.className = 'text-zinc-600 dark:text-zinc-300';
        inputLine.textContent = '> ';
        const resultLine = document.createElement('div');
        resultLine.className = 'text-accent';
        line.appendChild(inputLine);
        line.appendChild(resultLine);
        termOutput.appendChild(line);
        while (termOutput.children.length > 8) {
          termOutput.removeChild(termOutput.firstChild!);
        }
        scrollToBottom();
        for (const char of expr) {
          if (!typewriterActive) return;
          inputLine.textContent += char;
          await sleep(80);
        }
        await sleep(300);
        resultLine.textContent = `= ${result}`;
        scrollToBottom();
        await sleep(1000);
        typewriterIndex++;
      }
    };

    termInput.addEventListener('focus', () => {
      typewriterActive = false;
      termOutput.innerHTML = '';
    });

    termInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && termInput.value.trim()) {
        const expr = termInput.value.trim();
        const result = evaluate(expr);
        addLine(expr, result !== null ? String(result) : 'Error');
        termInput.value = '';
      }
    });

    typewriter();
  }
</script>