---
import type { Locale } from '~/i18n';
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import VersionNav from '~/components/changelog/VersionNav.astro';
import ReleaseCard from '~/components/changelog/ReleaseCard.astro';
import RevealScript from '~/components/RevealScript.astro';
import { t } from '~/i18n/ui';
import { parseReleaseBody, formatDateShort } from '~/lib/changelog';
import { SITE, BASE } from '~/lib/site';
import type { Release } from '~/lib/changelog';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const entries = await getCollection('changelog', (e) => e.data.locale === locale);
const releases: Release[] = entries
  .map((e) =>
    parseReleaseBody(e.body ?? '', {
      version: e.data.version,
      date: e.data.date ?? '',
      isUnreleased: e.data.isUnreleased,
      locale: e.data.locale,
    }),
  )
  .sort((a, b) => {
    if (a.isUnreleased) return -1;
    if (b.isUnreleased) return 1;
    return b.date.localeCompare(a.date);
  });

const datedReleases = releases.filter((r) => !r.isUnreleased && r.date);
const latest = datedReleases[0];
const earliest = datedReleases[datedReleases.length - 1];
const count = datedReleases.length;

const title = locale === 'zh-Hans' ? '更新日志 · AuraCalc' : 'Changelog · AuraCalc';
const description = locale === 'zh-Hans'
  ? 'AuraCalc 更新日志 · 查看每个版本的更新时间与主要迭代内容'
  : 'AuraCalc changelog · release dates and major changes for each version';
const canonicalPath = locale === 'zh-Hans' ? '/changelog' : '/en/changelog';

const lastModified = latest?.date ?? '2026-08-15';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'AuraCalc Changelog',
    alternateName: locale === 'zh-Hans' ? '更新日志' : 'Changelog',
    url: SITE + BASE + canonicalPath,
    inLanguage: locale === 'zh-Hans' ? 'zh-Hans' : 'en',
    description,
    dateModified: lastModified,
    isPartOf: { '@type': 'WebSite', name: 'AuraCalc', url: SITE + BASE + '/' },
    publisher: { '@type': 'Organization', name: 'AuraCalc', url: SITE },
    mainEntityOfPage: { '@type': 'WebPage', '@id': SITE + BASE + canonicalPath },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: locale === 'zh-Hans' ? '首页' : 'Home', item: SITE + BASE + '/' },
      { '@type': 'ListItem', position: 2, name: locale === 'zh-Hans' ? '更新日志' : 'Changelog', item: SITE + BASE + canonicalPath },
    ],
  },
];
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  ogType="article"
  jsonLd={jsonLd}
  publishedTime="2026-08-03T00:00:00+08:00"
  modifiedTime={`${lastModified}T00:00:00+08:00`}
  showBack
>
  <main class="mx-auto max-w-5xl px-5 sm:px-8 pt-10 sm:pt-14 pb-20">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[180px_minmax(0,1fr)] lg:gap-10">
      <VersionNav releases={releases} locale={locale} />

      <div class="min-w-0">
        <section class="mb-10" data-reveal>
          <div class="mb-2 flex items-center gap-2 font-mono text-xs uppercase tracking-[0.18em] text-accent">
            <span class="h-1.5 w-1.5 rounded-full bg-amber-400 shadow-[0_0_8px_rgba(251,191,36,0.6)]"></span>
            <span>{t(locale, 'changelog.eyebrow')}</span>
          </div>
          <h1 class="text-3xl font-bold leading-tight tracking-tight text-zinc-900 dark:text-zinc-50 sm:text-4xl">
            {t(locale, 'changelog.title')}
          </h1>
          <p class="mt-2 max-w-lg text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">
            {t(locale, 'changelog.lead')}
          </p>
          <div class="mt-5 grid grid-cols-3 gap-4">
            <div>
              <div class="text-xs text-zinc-500 dark:text-zinc-400">{t(locale, 'changelog.stat.first')}</div>
              <div class="mt-1 font-semibold text-zinc-900 dark:text-zinc-100">
                {earliest ? formatDateShort(earliest.date) : '—'}
              </div>
            </div>
            <div>
              <div class="text-xs text-zinc-500 dark:text-zinc-400">{t(locale, 'changelog.stat.latest')}</div>
              <div class="mt-1 font-semibold text-zinc-900 dark:text-zinc-100">
                {latest ? formatDateShort(latest.date) : '—'}
              </div>
            </div>
            <div>
              <div class="text-xs text-zinc-500 dark:text-zinc-400">{t(locale, 'changelog.stat.count')}</div>
              <div class="mt-1 font-semibold text-zinc-900 dark:text-zinc-100">{String(count)}</div>
            </div>
          </div>
        </section>

        <div class="relative" data-timeline>
          {releases.map((release) => <ReleaseCard release={release} locale={locale} />)}
        </div>
      </div>
    </div>
  </main>
  <RevealScript />
</BaseLayout>

<script>
  const observeActiveVersion = () => {
    const nav = document.querySelector('[data-version-nav]');
    if (!nav || window.matchMedia('(max-width: 1023px)').matches) return;
    const links = [...nav.querySelectorAll('[data-version-link]')] as HTMLAnchorElement[];
    const cards = [...document.querySelectorAll('[data-release-card]')] as HTMLElement[];
    if (!cards.length) return;

    const setActive = (id: string) => {
      links.forEach((link) => {
        link.setAttribute('aria-current', String(link.dataset.versionLink === id));
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-24px 0px -70% 0px', threshold: 0 },
    );

    cards.forEach((card) => observer.observe(card));
  };

  observeActiveVersion();
</script>
