---
import type { Locale } from '~/i18n';
import { t } from '~/i18n/ui';
import { mathTabs } from '~/data/math';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<section class="mx-auto max-w-5xl px-5 sm:px-8 py-16 sm:py-20">
  <h2 class="mb-2 font-mono text-xs uppercase tracking-[0.18em] text-accent">
    {t(locale, 'constants.label')}
  </h2>
  <p class="mb-8 text-zinc-500">{t(locale, 'constants.desc')}</p>
  <div data-math-tabs>
    <div class="mb-8 flex justify-center">
      <div
        class="inline-flex rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/60 dark:bg-zinc-900/60 p-1 backdrop-blur-md"
        data-math-bar
      >
        {mathTabs.map((tab, i) => (
          <button
            type="button"
            data-tab={String(i)}
            class="rounded-lg px-4 py-1.5 text-xs font-medium transition-all"
          >
            {tab.label[locale]}
          </button>
        ))}
      </div>
    </div>
    <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-4" data-math-panel></div>
  </div>
</section>

<script is:inline define:vars={{ mathTabs, locale }}>
  const renderPanel = (panel, idx) => {
    const items = mathTabs[idx].items;
    panel.innerHTML = items
      .map(
        (c) => `
      <div class="flex flex-col items-center justify-center rounded-xl border border-zinc-200/70 dark:border-zinc-800/70 bg-white/60 dark:bg-zinc-900/40 p-3.5 text-center transition-all hover:-translate-y-0.5 hover:border-zinc-300 dark:hover:border-zinc-700 hover:shadow-glass" title="${c.val}">
        <div class="mb-1 font-mono text-lg text-accent">${c.sym}</div>
        <div class="text-xs text-zinc-500 dark:text-zinc-400">${c.name[locale]}</div>
      </div>`,
      )
      .join('');
  };

  const updateTabs = (bar, panel, idx) => {
    bar.querySelectorAll('button').forEach((btn, i) => {
      const active = i === idx;
      btn.className = `rounded-lg px-4 py-1.5 text-xs font-medium transition-all ${active
        ? 'bg-white dark:bg-zinc-700 text-zinc-900 dark:text-zinc-50 shadow-sm'
        : 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-800 dark:hover:text-zinc-200'}`;
    });
    panel.style.opacity = '0';
    setTimeout(() => {
      renderPanel(panel, idx);
      panel.style.opacity = '1';
    }, 200);
  };

  const box = document.querySelector('[data-math-tabs]');
  if (box) {
    const bar = box.querySelector('[data-math-bar]');
    const panel = box.querySelector('[data-math-panel]');
    if (bar && panel) {
      panel.style.transition = 'opacity 0.35s var(--ease-apple, ease)';
      let idx = 0;
      renderPanel(panel, idx);
      updateTabs(bar, panel, idx);
      bar.querySelectorAll('button').forEach((btn, i) => {
        btn.addEventListener('click', () => {
          idx = i;
          updateTabs(bar, panel, idx);
        });
      });
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion) {
        setInterval(() => {
          idx = (idx + 1) % mathTabs.length;
          updateTabs(bar, panel, idx);
        }, 3000);
      }
    }
  }
</script>