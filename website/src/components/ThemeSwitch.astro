---
import type { Locale } from '~/i18n';
import { t } from '~/i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<div
  class="inline-flex items-center rounded-lg border border-zinc-200/80 dark:border-zinc-800/80 bg-white/60 dark:bg-zinc-900/60 p-0.5 backdrop-blur-md"
  data-theme-switch
>
  <button
    type="button"
    data-theme="light"
    aria-label={t(locale, 'theme.light')}
    aria-pressed="false"
    class="rounded-md p-1 transition-colors"
  >
    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"
    ><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
  </button>
  <button
    type="button"
    data-theme="dark"
    aria-label={t(locale, 'theme.dark')}
    aria-pressed="false"
    class="rounded-md p-1 transition-colors"
  >
    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"
    ><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
  </button>
  <button
    type="button"
    data-theme="system"
    aria-label={t(locale, 'theme.system')}
    aria-pressed="false"
    class="rounded-md p-1 transition-colors"
  >
    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"
    ><rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8M12 17v4" /></svg>
  </button>
</div>

<script>
  const initThemeSwitch = () => {
    const updateUI = () => {
      const api = window.__auracalcTheme;
      if (!api) return;
      const current = api.get();
      document.querySelectorAll('[data-theme-switch] [data-theme]').forEach((btn) => {
        const el = btn as HTMLButtonElement;
        const active = el.dataset.theme === current;
        el.setAttribute('aria-pressed', String(active));
        el.className = `rounded-md p-1 transition-colors ${active
          ? 'bg-amber-400/15 text-accent'
          : 'text-zinc-500 dark:text-zinc-500 hover:text-zinc-700 dark:hover:text-zinc-300'}`;
      });
    };
    document.querySelectorAll('[data-theme-switch] [data-theme]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const api = window.__auracalcTheme;
        const theme = (btn as HTMLButtonElement).dataset.theme;
        if (!api || !theme) return;
        api.set(theme);
        updateUI();
      });
    });
    updateUI();
  };
  document.addEventListener('astro:page-load', initThemeSwitch);
</script>