---
import type { Locale } from '~/i18n';
import { LOCALE_OG, DEFAULT_LOCALE, localePath } from '~/i18n';
import ThemeScript from './ThemeScript.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  alternatePaths?: Partial<Record<Locale, string>>;
  ogType?: 'website' | 'article';
  jsonLd?: object | object[];
  publishedTime?: string;
  modifiedTime?: string;
  skipLangDetect?: boolean;
}

const {
  locale,
  title,
  description,
  canonicalPath,
  alternatePaths,
  ogType = 'website',
  jsonLd,
  publishedTime,
  modifiedTime,
  skipLangDetect = false,
} = Astro.props;

import { SITE, BASE, pageUrl } from '~/lib/site';
const canonical = pageUrl(canonicalPath);
const ogLocale = LOCALE_OG[locale];
const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const basePath = canonicalPath.replace(/^\/en/, '') || '/';
const alternates = alternatePaths ?? {
  'zh-Hans': localePath('zh-Hans', basePath),
  'en': localePath('en', basePath),
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="description" content={description} />
<title>{title}</title>
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="zh-Hans" href={SITE + alternates['zh-Hans']} />
<link rel="alternate" hreflang="en" href={SITE + alternates['en']} />
<link rel="alternate" hreflang="x-default" href={SITE + alternates[DEFAULT_LOCALE]} />
<link rel="icon" type="image/svg+xml" href={`${BASE}/favicon.svg`} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="AuraCalc" />
<meta property="og:locale" content={ogLocale} />
{locale === 'zh-Hans' && <meta property="og:locale:alternate" content="en_US" />}
{locale === 'en' && <meta property="og:locale:alternate" content="zh_CN" />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="og:updated_time" content={modifiedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
<meta property="article:author" content="AuraCalc" />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

{jsonLdArray.map((block) => (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
))}

<ThemeScript />

{locale === 'zh-Hans' && !skipLangDetect && (
  <script is:inline define:vars={{ enHref: alternates['en'] }}>
    (function () {
      try {
        if (localStorage.getItem('lang-pref')) return;
        var langs = navigator.languages || [navigator.language || ''];
        var isZh = false;
        for (var i = 0; i < langs.length; i++) {
          if (langs[i] && langs[i].toLowerCase().indexOf('zh') === 0) { isZh = true; break; }
        }
        if (!isZh) location.replace(enHref);
      } catch (e) {}
    })();
  </script>
)}