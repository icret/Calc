---
import type { Locale } from '~/i18n';
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import RevealScript from '~/components/RevealScript.astro';
import { t } from '~/i18n/ui';
import { galleryItems } from '~/data/gallery';
import { SITE, BASE, pageUrl } from '~/lib/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const title = locale === 'zh-Hans' ? '产品截图 · AuraCalc' : 'Gallery · AuraCalc';
const description = locale === 'zh-Hans'
  ? 'AuraCalc macOS 界面截图集 · Liquid Glass 视觉语言'
  : 'AuraCalc macOS UI gallery · Liquid Glass visuals';
const canonicalPath = locale === 'zh-Hans' ? '/gallery' : '/en/gallery';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ImageGallery',
    name: 'AuraCalc Gallery',
    alternateName: locale === 'zh-Hans' ? '产品截图' : 'Gallery',
    url: pageUrl(canonicalPath),
    inLanguage: locale === 'zh-Hans' ? 'zh-Hans' : 'en',
    description,
    image: galleryItems.map((item) => ({
      '@type': 'ImageObject',
      contentUrl: SITE + item.image.src,
      caption: item.caption[locale],
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: locale === 'zh-Hans' ? '首页' : 'Home', item: SITE + BASE + '/' },
      { '@type': 'ListItem', position: 2, name: locale === 'zh-Hans' ? '产品截图' : 'Gallery', item: pageUrl(canonicalPath) },
    ],
  },
];
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  ogType="article"
  jsonLd={jsonLd}
  showBack
>
  <main class="mx-auto max-w-5xl px-5 sm:px-8 pt-10 sm:pt-14 pb-20">
    <section class="mb-10" data-reveal>
      <div class="mb-2 flex items-center gap-2 font-mono text-xs uppercase tracking-[0.18em] text-accent">
        <span class="h-1.5 w-1.5 rounded-full bg-amber-400 shadow-[0_0_8px_rgba(251,191,36,0.6)]"></span>
        <span>{t(locale, 'gallery.eyebrow')}</span>
      </div>
      <h1 class="text-3xl font-bold leading-tight tracking-tight text-zinc-900 dark:text-zinc-50 sm:text-4xl">
        {t(locale, 'gallery.title')}
      </h1>
      <p class="mt-2 max-w-lg text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">
        {t(locale, 'gallery.lead')}
      </p>
    </section>

    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {galleryItems.map((item, index) => (
        <li data-reveal style={`--reveal-delay: ${Math.min(index * 40, 320)}ms;`}>
          <button
            type="button"
            class="group block w-full overflow-hidden rounded-xl border border-zinc-200/60 dark:border-zinc-800/60 bg-zinc-100/50 dark:bg-zinc-900/50 shadow-glass transition-all hover:shadow-lift hover:-translate-y-0.5"
            data-gallery-trigger
            data-full-src={item.image.src}
            data-caption={item.caption[locale]}
            aria-label={item.alt[locale]}
          >
            <Image
              src={item.image}
              alt={item.alt[locale]}
              widths={[400, 800]}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
              class="aspect-video w-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.03]"
            />
            <div class="px-3 py-2 text-left text-xs font-mono text-zinc-500 dark:text-zinc-400">
              {item.caption[locale]}
            </div>
          </button>
        </li>
      ))}
    </ul>
  </main>

  <dialog
    id="gallery-lightbox"
    class="m-auto max-h-[90vh] max-w-[95vw] rounded-2xl border-0 bg-zinc-950/95 p-2 backdrop:bg-black/80 backdrop:backdrop-blur-sm"
    aria-label={t(locale, 'gallery.lightbox.label')}
  >
    <img data-lightbox-img alt="" class="max-h-[82vh] max-w-[90vw] rounded-lg object-contain" />
    <div data-lightbox-caption class="mt-2 text-center text-sm font-mono text-zinc-300"></div>
    <button
      type="button"
      data-lightbox-close
      class="absolute right-3 top-3 rounded-full bg-zinc-800/80 p-2 text-zinc-200 transition-colors hover:bg-zinc-700"
      aria-label={t(locale, 'gallery.lightbox.close')}
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-4 w-4"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>
  </dialog>

  <RevealScript />
</BaseLayout>

<script>
  const dialog = document.getElementById('gallery-lightbox') as HTMLDialogElement | null;
  const lightboxImg = document.querySelector('[data-lightbox-img]') as HTMLImageElement | null;
  const lightboxCaption = document.querySelector('[data-lightbox-caption]') as HTMLElement | null;

  if (dialog && lightboxImg && lightboxCaption) {
    document.querySelectorAll('[data-gallery-trigger]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const el = btn as HTMLElement;
        lightboxImg.src = el.dataset.fullSrc ?? '';
        lightboxImg.alt = el.getAttribute('aria-label') ?? '';
        lightboxCaption.textContent = el.dataset.caption ?? '';
        dialog.showModal();
      });
    });

    document.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>